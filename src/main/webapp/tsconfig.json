{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@feature/*": [
        "./src/features/*"
      ],
      "@test/*": [
        "./src/test/*"
      ],
      "@api/auth": [
        "./generated/auth-client/src/index.ts"
      ],
      "@api/shared": [
        "./generated/shared-client/src/index.ts"
      ],
      "@api/inbox": [
        "./generated/inbox-client/src/index.ts"
      ],
      "@api/notes": [
        "./generated/notes-client/src/index.ts"
      ],
      "@api/identity": [
        "./generated/identity-client/src/index.ts"
      ],
      "@api/sync": [
        "./generated/sync-client/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
