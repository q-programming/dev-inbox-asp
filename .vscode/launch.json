{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run UI",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/DevInbox.Web/ClientApp",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "DevInbox.Web (Backend Only)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/DevInbox.Web/bin/Debug/net10.0/DevInbox.Web.dll",
      "cwd": "${workspaceFolder}/DevInbox.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Local"
      }
    }
  ]
}