<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevInbox.Web</RootNamespace>
    <AssemblyName>DevInbox.Web</AssemblyName>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <Version>0.1.0</Version>
    <UserSecretsId>devinbox-web-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Macross.Json.Extensions" Version="3.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.*" />
  </ItemGroup>

  <!-- Exclude ClientApp source from build output — only the compiled wwwroot matters -->
  <ItemGroup>
    <Content Remove="ClientApp\**" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Common\Events\" />
  </ItemGroup>

  <!--
    Ensure local dotnet tools (nswag, from dotnet-tools.json) are restored before they're invoked.
    Without this, a fresh clone on a machine that never ran `dotnet tool restore` (e.g. Visual Studio's
    own build, or a new OS/user profile with its own NuGet cache) fails with MSB3073 because the
    "dotnet nswag" command isn't available yet. This runs on every build but is a fast no-op once
    the tools are already restored.
  -->
  <Target Name="RestoreLocalDotnetTools" BeforeTargets="BootstrapGenerateCsClients;GenerateClients">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildProjectDirectory)/.." />
  </Target>

  <!--
    Bootstrap: generate C# controller file if missing (e.g. after git clean or fresh clone).
    Always runs when the file is absent regardless of GenerateClients — the file must exist to compile.
  -->
  <Target Name="BootstrapGenerateCsClients" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet nswag openapi2cscontroller /input:openapi/api.yml /output:Infrastructure/OpenApi/Generated/Controllers.cs /namespace:DevInbox.Web.Infrastructure.OpenApi.Generated /className:{controller}Base /operationGenerationMode:MultipleClientsFromFirstTagAndOperationId /jsonLibrary:SystemTextJson /templateDirectory:$(MSBuildProjectDirectory)/openapi/nswag-templates" />
    <ItemGroup>
      <Compile Include="Infrastructure/OpenApi/Generated/Controllers.cs" />
    </ItemGroup>
  </Target>

  <!--
    On-demand regeneration: delete and regenerate both generated files from api.yml.
    C# controller bases + DTOs for the backend, TypeScript fetch client for React.
    Only runs when GenerateClients=true — e.g. `dotnet build /p:GenerateClients=true` or `make generate-api`.
  -->
  <Target Name="GenerateClients" AfterTargets="Build">
    <Delete Files="Infrastructure/OpenApi/Generated/Controllers.cs" />
    <Delete Files="ClientApp/generated/api-client/index.ts" />
    <Exec Command="dotnet nswag openapi2cscontroller /input:openapi/api.yml /output:Infrastructure/OpenApi/Generated/Controllers.cs /namespace:DevInbox.Web.Infrastructure.OpenApi.Generated /className:{controller}Base /operationGenerationMode:MultipleClientsFromFirstTagAndOperationId /jsonLibrary:SystemTextJson /templateDirectory:$(MSBuildProjectDirectory)/openapi/nswag-templates" />
    <Exec Command="dotnet nswag openapi2tsclient /input:openapi/api.yml /output:ClientApp/generated/api-client/index.ts /template:Fetch /operationGenerationMode:MultipleClientsFromFirstTagAndOperationId /typeStyle:Interface" />
  </Target>

  <!--
    On publish: build React app and embed output in wwwroot for a self-contained binary.
  -->
  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="ClientApp" Command="npm install" />
    <Exec WorkingDirectory="ClientApp" Command="npm run build" />
    <ItemGroup>
      <DistFiles Include="ClientApp\wwwroot\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
