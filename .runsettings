<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared test run settings — picked up automatically by VS and `dotnet test`.
  Equivalent to JaCoCo <excludes> in Maven: generated code is excluded from coverage.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Exclude NSwag-generated controller stubs — these are regenerated on every build -->
          <ExcludeByFile>**/Infrastructure/OpenApi/Generated/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- .NET Runtime Settings -->
  <RunConfiguration>
    <MaxCpuCount>0</MaxCpuCount>
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    <TargetFramework>net10.0</TargetFramework>
  </RunConfiguration>

  <!-- Environment variables for tests - ensures appsettings.Testing.json is loaded -->
  <EnvironmentVariables>
    <ASPNETCORE_ENVIRONMENT>Testing</ASPNETCORE_ENVIRONMENT>
    <DOTNET_ENVIRONMENT>Testing</DOTNET_ENVIRONMENT>
  </EnvironmentVariables>
</RunSettings>
