# Copy to docker/.env (git-ignored) and fill in. Used by: docker compose -f docker/docker-compose.yml up -d --build
APP_PORT=8080

# Bundled compose postgres:  Host=postgres;Database=devinbox;Username=devinbox;Password=devinbox
# Postgres running on the host: use Host=host.docker.internal (and the host port)
CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=devinbox;Username=devinbox;Password=devinbox

# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=SomeRadomSecurityKeyThatIsAtLeast48BytesLong
ENCRYPTION_PASSWORD=SomeRadomSecurityKeyThatIsAtLeast32BytesLong
ENCRYPTION_SALT=AndSaltThatIsAtLeast16BytesLong

# GitHub OAuth App — callback URL must point at <your host>/api/auth/github/callback
GITHUB_CLIENT_ID=Ov23li5JX9d3VlafxLAO
GITHUB_CLIENT_SECRET=6965461da34c92cf10d9a25181ebc697ac0d2fdd

# Leave empty when the UI is served by the app itself
FRONTEND_URL=
ADO_BASE_URL=https://dev.azure.com
