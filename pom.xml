<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>pl.qprogramming</groupId>
    <artifactId>devinbox</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>${packaging.type}</packaging>
    <name>Dev Inbox</name>
    <description>Personal developer workspace — unified inbox for GitHub PRs, ADO work items and notes</description>

    <profiles>
        <profile>
            <id>jar</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <packaging.type>jar</packaging.type>
            </properties>
        </profile>
        <profile>
            <id>war</id>
            <properties>
                <packaging.type>war</packaging.type>
            </properties>
        </profile>
    </profiles>

    <properties>
        <java.version>21</java.version>
        <packaging.type>jar</packaging.type>

        <!-- Node / npm versions for frontend-maven-plugin -->
        <node.version>v22.15.0</node.version>
        <npm.version>10.9.2</npm.version>

        <!-- Dependency versions -->
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <lombok.version>1.18.38</lombok.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <openapi-generator.version>7.13.0</openapi-generator.version>
        <springdoc.version>2.8.9</springdoc.version>
        <jackson-databind-nullable.version>0.2.10</jackson-databind-nullable.version>
        <swagger-annotations.version>2.2.30</swagger-annotations.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <archunit.version>1.4.0</archunit.version>
        <liquibase.version>4.31.1</liquibase.version>
        <micrometer-tracing.version>1.5.0</micrometer-tracing.version>

        <!-- Plugin versions -->
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ===== Spring Boot Core ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ===== Spring Modulith ===== -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jpa</artifactId>
        </dependency>
        <!-- Modulith Insight for dev observability -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-insight</artifactId>
        </dependency>

        <!-- ===== Database ===== -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <version>${liquibase.version}</version>
        </dependency>

        <!-- ===== OpenAPI / Swagger ===== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>${jackson-databind-nullable.version}</version>
        </dependency>

        <!-- ===== Observability ===== -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ===== Code Generation Helpers ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- ===== Testing ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Modulith test support (ModularityTests) -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Modulith docs (UML diagram generation in tests) -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-docs</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <!-- ===== Surefire: pass Docker env to Testcontainers ===== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <DOCKER_HOST>unix:///var/run/docker.sock</DOCKER_HOST>
                    </environmentVariables>
                    <systemPropertyVariables>
                        <DOCKER_API_VERSION>1.47</DOCKER_API_VERSION>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- ===== Java Compiler with Lombok + MapStruct ===== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- ===== Spring Boot Maven Plugin ===== -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- ===== OpenAPI Generator ===== -->
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>

                    <!-- ── Java: shared (health) ─────────────────────────────── -->
                    <execution>
                        <id>generate-shared-stubs</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/shared/health.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi-shared</output>
                            <apiPackage>pl.qprogramming.devinbox.shared.api</apiPackage>
                            <modelPackage>pl.qprogramming.devinbox.shared.dto</modelPackage>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <delegatePattern>true</delegatePattern>
                                <title>Shared</title>
                                <serializableModel>true</serializableModel>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── Java: inbox + saved-views ─────────────────────────── -->
                    <execution>
                        <id>generate-inbox-stubs</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/inbox/inbox.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi-inbox</output>
                            <apiPackage>pl.qprogramming.devinbox.inbox.api</apiPackage>
                            <modelPackage>pl.qprogramming.devinbox.inbox.dto</modelPackage>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <delegatePattern>true</delegatePattern>
                                <title>Inbox</title>
                                <serializableModel>true</serializableModel>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── Java: notes ───────────────────────────────────────── -->
                    <execution>
                        <id>generate-notes-stubs</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/notes/notes.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi-notes</output>
                            <apiPackage>pl.qprogramming.devinbox.notes.api</apiPackage>
                            <modelPackage>pl.qprogramming.devinbox.notes.dto</modelPackage>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <delegatePattern>true</delegatePattern>
                                <title>Notes</title>
                                <serializableModel>true</serializableModel>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── Java: identity (settings) ─────────────────────────── -->
                    <execution>
                        <id>generate-identity-stubs</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/identity/settings.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi-identity</output>
                            <apiPackage>pl.qprogramming.devinbox.identity.api</apiPackage>
                            <modelPackage>pl.qprogramming.devinbox.identity.dto</modelPackage>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <delegatePattern>true</delegatePattern>
                                <title>Identity</title>
                                <serializableModel>true</serializableModel>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── Java: sync ────────────────────────────────────────── -->
                    <execution>
                        <id>generate-sync-stubs</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/sync/sync.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <output>${project.build.directory}/generated-sources/openapi-sync</output>
                            <apiPackage>pl.qprogramming.devinbox.sync.api</apiPackage>
                            <modelPackage>pl.qprogramming.devinbox.sync.dto</modelPackage>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <skipValidateSpec>true</skipValidateSpec>
                            <configOptions>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <delegatePattern>true</delegatePattern>
                                <title>Sync</title>
                                <serializableModel>true</serializableModel>
                                <useTags>true</useTags>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── TypeScript: shared-client ─────────────────────────── -->
                    <execution>
                        <id>generate-shared-ts-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/shared/health.yml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.basedir}/src/main/webapp/generated/shared-client</output>
                            <generateApis>true</generateApis>
                            <configOptions>
                                <npmName>@devinbox/shared-client</npmName>
                                <npmVersion>${project.version}</npmVersion>
                                <modelPropertyNaming>original</modelPropertyNaming>
                                <typescriptThreePlus>true</typescriptThreePlus>
                                <supportsES6>true</supportsES6>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── TypeScript: inbox-client ───────────────────────────── -->
                    <execution>
                        <id>generate-inbox-ts-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/inbox/inbox.yml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.basedir}/src/main/webapp/generated/inbox-client</output>
                            <generateApis>true</generateApis>
                            <configOptions>
                                <npmName>@devinbox/inbox-client</npmName>
                                <npmVersion>${project.version}</npmVersion>
                                <modelPropertyNaming>original</modelPropertyNaming>
                                <typescriptThreePlus>true</typescriptThreePlus>
                                <supportsES6>true</supportsES6>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── TypeScript: notes-client ───────────────────────────── -->
                    <execution>
                        <id>generate-notes-ts-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/notes/notes.yml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.basedir}/src/main/webapp/generated/notes-client</output>
                            <generateApis>true</generateApis>
                            <configOptions>
                                <npmName>@devinbox/notes-client</npmName>
                                <npmVersion>${project.version}</npmVersion>
                                <modelPropertyNaming>original</modelPropertyNaming>
                                <typescriptThreePlus>true</typescriptThreePlus>
                                <supportsES6>true</supportsES6>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── TypeScript: identity-client ────────────────────────── -->
                    <execution>
                        <id>generate-identity-ts-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/identity/settings.yml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.basedir}/src/main/webapp/generated/identity-client</output>
                            <generateApis>true</generateApis>
                            <configOptions>
                                <npmName>@devinbox/identity-client</npmName>
                                <npmVersion>${project.version}</npmVersion>
                                <modelPropertyNaming>original</modelPropertyNaming>
                                <typescriptThreePlus>true</typescriptThreePlus>
                                <supportsES6>true</supportsES6>
                            </configOptions>
                        </configuration>
                    </execution>

                    <!-- ── TypeScript: sync-client ────────────────────────────── -->
                    <execution>
                        <id>generate-sync-ts-client</id>
                        <goals><goal>generate</goal></goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/resources/swagger/sync/sync.yml</inputSpec>
                            <generatorName>typescript-fetch</generatorName>
                            <output>${project.basedir}/src/main/webapp/generated/sync-client</output>
                            <generateApis>true</generateApis>
                            <configOptions>
                                <npmName>@devinbox/sync-client</npmName>
                                <npmVersion>${project.version}</npmVersion>
                                <modelPropertyNaming>original</modelPropertyNaming>
                                <typescriptThreePlus>true</typescriptThreePlus>
                                <supportsES6>true</supportsES6>
                            </configOptions>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <!-- ===== Frontend Build (Node + npm via Maven) ===== -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>src/main/webapp</workingDirectory>
                    <installDirectory>target</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-test</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>run test:ci</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ===== Copy frontend dist → static resources ===== -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>src/main/webapp/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ===== WAR packaging (optional profile) ===== -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <packagingExcludes>
                        WEB-INF/classes/node_modules/**,
                        WEB-INF/classes/src/**,
                        WEB-INF/classes/generated/**,
                        WEB-INF/classes/public/**,
                        WEB-INF/classes/*.json,
                        WEB-INF/classes/*.ts,
                        WEB-INF/classes/*.mjs,
                        **/node_modules/**,
                        **/node/**,
                        **/*.ts,
                        **/*.tsx,
                        **/*.json,
                        **/.vite/**
                    </packagingExcludes>
                </configuration>
            </plugin>

            <!-- ===== JaCoCo Coverage ===== -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
